# Where the SQLite database and uploaded photos live (default: ./data)
CONFERENCER_DATA_DIR=./data

# Schedule parser: "text" (built-in heuristic parser, default) or "vlm"
SCHEDULE_PARSER=text

# VLM provider used when SCHEDULE_PARSER=vlm: "mock" (default) or "openai-compatible"
VLM_PROVIDER=mock
# For an OpenAI-compatible endpoint (e.g. a university vLLM server)
VLM_BASE_URL=https://vlm.example-uni.edu/v1
VLM_API_KEY=
VLM_MODEL=Qwen2.5-VL-7B-Instruct
